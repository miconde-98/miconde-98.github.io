---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import {publicPosts} from '../../../lib/content';
import { tr,localized } from '../../../lib/i18n';
import type {Lang} from '../../../lib/i18n';
import blogData from '../../../data/blog-page.json';
export function getStaticPaths(){return [{params:{lang:'fr'}},{params:{lang:'en'}}];}
const lang=Astro.params.lang as Lang;
const t=tr(lang);
const page=blogData[lang];
const posts=await publicPosts();
---
<BaseLayout lang={lang} title={page.title} description={page.seoDescription || page.intro}>
  <section class="page-head container"><p class="overline">{page.kicker}</p><h1>{page.title}</h1><p>{page.intro}</p></section>
  <section class="container posts-section">
    <div class="filter-toolbar" aria-label="Article filters">
      <label class="search-field"><span aria-hidden="true">⌕</span><input type="search" id="post-search" placeholder={t.search} aria-label={t.search}/></label>
      <select id="post-category" aria-label={t.all}>
        <option value="all">{t.all}</option>
        {Object.entries(t.groups).map(([v,label])=><option value={v}>{label}</option>)}
      </select>
      <select id="post-language" aria-label={t.allLangs}><option value="all">{t.allLangs}</option><option value="fr">Français</option><option value="en">English</option></select>
    </div>
    {posts.length ? <><div class="cards-grid" id="posts-grid">{posts.map(p=><PostCard post={p} lang={lang}/>)}</div><p class="empty-state" id="posts-empty" hidden>{t.noMatches}</p></> : <div class="empty-state">{t.noPosts}</div>}
    <div class="blog-rss">RSS ↗ <a href={localized(lang,'feed.xml')}>{page.rssLabel}</a></div>
  </section>
</BaseLayout>
<script>
  const input=document.getElementById('post-search') as HTMLInputElement|null;
  const cat=document.getElementById('post-category') as HTMLSelectElement|null;
  const langSelect=document.getElementById('post-language') as HTMLSelectElement|null;
  const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-post-card]'));
  const empty=document.getElementById('posts-empty');
  const filter=()=>{
    const query=(input?.value||'').trim().toLocaleLowerCase();let shown=0;
    cards.forEach(card=>{const visible=(cat?.value==='all'||card.dataset.category===cat?.value)&&(langSelect?.value==='all'||card.dataset.lang===langSelect?.value)&&(!query||(card.dataset.search||'').includes(query));card.hidden=!visible;if(visible)shown++;});
    if(empty)empty.hidden=shown>0;
  };
  input?.addEventListener('input',filter);cat?.addEventListener('change',filter);langSelect?.addEventListener('change',filter);
</script>
