---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../lib/i18n';
import { tr,localized } from '../lib/i18n';
import {tags} from '../lib/content';
interface Props {project: CollectionEntry<'projects'>; lang:Lang;}
const {project,lang}=Astro.props;
const t=tr(lang);
const title=lang==='fr'?project.data.title_fr:project.data.title_en;
const summary=lang==='fr'?project.data.summary_fr:project.data.summary_en;
---
<article class="project-card" data-project-category={project.data.category}>
  <div class="project-card-top"><span class="category-icon" aria-hidden="true">{project.data.category==='research'?'Σ':project.data.category==='ml'?'✧':project.data.category==='data'?'{}':'▥'}</span><span class="status-tag">{t[project.data.status]}</span></div>
  <div class="micro-line"><span>{t.projectGroups[project.data.category]}</span></div>
  <h3><a href={localized(lang,`projects/${project.id}/`)}>{title}</a></h3><p>{summary}</p>
  <div class="tag-row">{tags(project.data.tools).map(tag=><span class="skill-chip">{tag}</span>)}</div>
  <div class="card-bottom"><a href={localized(lang,`projects/${project.id}/`)} class="text-arrow">{t.learnMore} ↗</a>{project.data.github && <a href={project.data.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">GitHub ↗</a>}</div>
</article>
